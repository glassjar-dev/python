# Pinned inputs for glassjar's CPython WASI build.
CPYTHON_VERSION=3.15.2
WASI_SDK_VERSION=33
BINARYEN_NOTE="not used: clang only runs wasm-opt for optimized links, and CPython's Makefile links without -O"
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) WASI_SDK_HOST=arm64-macos; WASI_SDK_SHA256=85c997a2665ead91673b5bb88b7d0df3fc8900df3bfa244f720d478187bbdc78 ;;
  Linux-x86_64) WASI_SDK_HOST=x86_64-linux; WASI_SDK_SHA256=0ba8b5bfaeb2adf3f29bab5841d76cf5318ab8e1642ea195f88baba1abd47bce ;;
  *) echo "unsupported host $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac
WASI_SDK_DIR=wasi-sdk-${WASI_SDK_VERSION}.0-${WASI_SDK_HOST}
ZLIB_VERSION=1.4
ZLIB_SHA256=02dd159783677a749c04adbdd02b55b8a2bcc7e054f51b76b549199a916ad584
BZIP2_VERSION=1.0.8
BZIP2_SHA256=ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269
XZ_VERSION=5.8.4
XZ_SHA256=0014c7886930454fe8bd4228665b51af55eeae560ea135c9c4cd33f55b2591d9
SQLITE_YEAR=2026
SQLITE_VERSION=3540100
SQLITE_SHA256=926ef8d3eab93fbf6e06011901273eec076b25594a4e1cdadd50c987f4f6d64e
